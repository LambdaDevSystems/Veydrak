{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "veydrak",
  "version": "0.1.0",
  "identifier": "com.lambdadevsystems.veydrak",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [{ "label": "main", "title": "SENTINEL", "width": 1280, "height": 800 }]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "dmg", "app", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMEQ4NDYwRTIxNDEwM0EKUldRNkVCVGlZSVFOYXhrcXNHOFhsYWF0N28wWGpJSC9HZDA5WHM1aUdSTSt3cjB3K1ZsWThCNU0K",
      "endpoints": ["https://github.com/LambdaDevSystems/Veydrak/releases/latest/download/latest.json"]
    }
  }
}
